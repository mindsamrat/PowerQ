# PQ Assessment — environment variables
# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit a real .env file (it is gitignored). Values are trimmed, so a
# stray space from a paste is harmless.

# --- Supabase (required in production) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Secret / service-role key. Server-only. Never expose to the browser.
# (SUPABASE_SERVICE_ROLE_KEY is still accepted as a fallback name.)
SUPABASE_SECRET_KEY=

# --- Dodo Payments (required for the $3 report) ---
DODO_API_KEY=
# The pdt_... id of the report product. Must belong to the same mode (test/live) as the API key.
DODO_PRODUCT_ID=
# Signing secret from the webhook you registered at /api/webhooks/dodo (starts with whsec_).
# Subscribe the webhook to: payment.succeeded, refund.succeeded, dispute.* (see docs/OPERATIONS.md).
DODO_WEBHOOK_SECRET=
# Leave unset for live. Set to https://test.dodopayments.com ONLY in a Vercel Preview environment.
# DODO_API_BASE=https://test.dodopayments.com
# Optional: your Dodo business id. When set, payments from any other business are ignored.
# DODO_BUSINESS_ID=

# --- Scheduled job (recommended) ---
# Long random string. Vercel sends it with the daily /api/cron/daily call so nobody else can trigger it.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Sovereign Doctrine (optional) ---
# Where every "Get Sovereign Doctrine" button sends people (/book redirects here with UTM tags).
# Falls back to https://wayofgods.com when unset.
SOVEREIGN_DOCTRINE_URL=

# --- Admin (optional) ---
# Long random string, at least 16 characters (openssl rand -hex 32).
# Unlocks https://quiz.wayofgods.com/admin/psychometrics?token=<value>
# (question quality, reliability, distributions). Leave unset to disable the page entirely.
ADMIN_TOKEN=
